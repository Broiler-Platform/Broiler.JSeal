<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.JSeal.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.JSeal\Broiler.JSeal.csproj" />
    <ProjectReference Include="..\Broiler.JSeal.BroilerJs\Broiler.JSeal.BroilerJs.csproj" />
  </ItemGroup>

  <!-- VM configurations add the VM reference and its explicit test-discovery registration. -->
  <ItemGroup Condition="'$(BroilerJavaScriptEngine)' == 'Vm'">
    <ProjectReference Include="..\Broiler.JSeal.Vm\Broiler.JSeal.Vm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Jseal\VmProviderRegistration.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(BroilerJavaScriptEngine)' == 'Vm'">
    <Compile Include="Jseal\VmProviderRegistration.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
