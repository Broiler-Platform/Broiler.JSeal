<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Broiler.JS engine packages for Broiler.JSeal.BroilerJs -->
    <PackageVersion Include="Broiler.JavaScript.BuiltIns" Version="0.1.0-preview.10" />
    <PackageVersion Include="Broiler.JavaScript.Globals" Version="0.1.0-preview.10" />
    <PackageVersion Include="Broiler.JavaScript.Modules" Version="0.1.0-preview.10" />
    <PackageVersion Include="Broiler.JavaScript.Storage" Version="0.1.0-preview.10" />
    <!-- Broiler.VM engine packages for Broiler.JSeal.Vm -->
    <PackageVersion Include="Broiler.VM.Profile.JavaScript" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.VM.Profile.JavaScript.Compiler" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.VM.Runtime" Version="0.1.0-preview.6" />
    <!-- Test dependencies for Broiler.JSeal.Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>