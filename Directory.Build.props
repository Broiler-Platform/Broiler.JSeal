<Project>

  <!-- Configuration mapping for Debug-VM / Release-VM build types -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Broiler.Configurations.props" />

  <!-- Broiler NuGet packaging metadata (vendored; do not edit by hand). -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Broiler.Packaging.props" />

  <!-- Repository-owned packaging overrides. -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.JSeal</PackageProjectUrl>
    <PackageTags>broiler;jseal;javascript;engine;abstraction;interop;realm</PackageTags>
  </PropertyGroup>

  <!-- The vendored props pack the repository README, which is written for this repository:
       its links are relative, so they break on nuget.org. Packages carry their own README,
       still packed as README.md so PackageReadmeFile needs no override. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Remove="$(MSBuildThisFileDirectory)README.md" />
    <None Include="$(MSBuildThisFileDirectory)eng\nuget\README.md"
          Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    ════════════════════════════════════════════════════════════════════
    THE TWO DIAGNOSTICS THIS COMPONENT PROMOTES TO ERRORS.

    Both are about JsValue — the JSEAL handle in Broiler.JSeal/Values/JsValue.cs.
    It is a STRUCT, and the engine-typed storage it replaced was a class.
    Promoting CA2013 and CS8073 ensures struct null-comparison bugs are caught
    at compile time rather than silently failing open.
    ════════════════════════════════════════════════════════════════════
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CA2013;CS8073</WarningsAsErrors>
  </PropertyGroup>

  <!--
    The one suppression left from the extraction. The nullable family (CS8600-CS8767) is no longer
    suppressed anywhere (J15, J16), and CS9113, CA1416 and SYSLIB0013 were dropped once no project
    raised them. CA2255 stays: the providers register themselves from [ModuleInitializer] methods,
    which is the intended use in a library. The reference-free contracts need none of it, so they
    inherit nothing here; a suppression they one day need belongs in Broiler.JSeal.csproj with its
    reason.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Broiler.JSeal'">
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

</Project>
